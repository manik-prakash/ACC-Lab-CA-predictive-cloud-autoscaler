# Copy to .env (git-ignored) and fill in. No secrets here: AWS keys live in the AWS CLI profile (~/.aws/credentials).
AWS_PROFILE=ia-autoscaler
AWS_REGION=ap-southeast-2
# Needed by scripts/live_demo.py up and scripts/deploy-phase1.ps1:
VPC_ID=vpc-xxxxxxxx
SUBNET_IDS=subnet-aaaaaaaa,subnet-bbbbbbbb
AMI_ID=ami-xxxxxxxx
# Optional resource names (defaults shown):
# ASG_NAME=ia-autoscaler-asg
# ALB_NAME=ia-autoscaler-alb
# TG_NAME=ia-autoscaler-tg
# SG_NAME=ia-autoscaler-web-sg
